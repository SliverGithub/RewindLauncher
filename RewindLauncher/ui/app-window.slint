import { HorizontalBox, VerticalBox, ListView, Button, ScrollView } from "std-widgets.slint";

export struct modentry {
    name: string,
    depth: int,
}

export struct gamedata {
    name: string,
    publisher: string,
    icon: image,
    script: string,
    modlist: [modentry],
}

export component AppWindow inherits Window {
    title: "Rewind Launcher";

    in property <[gamedata]> games;
    in-out property <bool> show-details: false;
    in-out property <int> selected-index: -1;

    callback game-selected(int);
    callback patch-clicked(int);

    // Page 1: Game list (kept alive when hidden)
    Rectangle {
        width: 100%;
        height: 100%;
        visible: !root.show-details;

        ListView {
            width: 100%;
            height: 100%;

            for game[idx] in root.games: Rectangle {
                height: 60px;
                    TouchArea {
                        horizontal-stretch: 1;
                        clicked => {
                            root.selected-index = idx;
                            root.show-details = true;
                            root.game-selected(idx);}

                            HorizontalBox {
                                alignment: stretch;

                                HorizontalBox {
                                    alignment: start;

                                    Image {
                                        source: game.icon;
                                        width: 44px;
                                        height: 44px;
                                        image-fit: contain;
                                    }

                                    VerticalLayout {
                                        alignment: center;

                                    Text {
                                        text: game.name;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: game.publisher;
                                        color: #888888;
                                        font-size: 12px;
                                    }
                                }
                                Button {
                                        text: "Patch!";
                                        clicked => {
                                            root.patch-clicked(idx);
                                        }
                                    }
                            }
                        }
                    }
                }
            }
        }

    // Page 2: Selected game full info
        Rectangle {
            width: 100%;
            height: 100%;
            visible: root.show-details && root.selected-index >= 0 && root.selected-index < root.games.length;

            VerticalBox {
                padding: 20px;
                spacing: 12px;

                HorizontalBox {
                    alignment: start;
                    spacing: 12px;

                    Button {
                        text: "Back";
                            clicked => {
                            root.show-details = false;
                            }
                    }

                    Image {
                        source: root.games[root.selected-index].icon;
                        width: 64px;
                        height: 64px;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: root.games[root.selected-index].name;
                            font-size: 20px;
                            font-weight: 700;
                        }

                        Text {
                            text: root.games[root.selected-index].publisher;
                            color: #888888;
                            font-size: 14px;
                        }
                    }
                }

                Text {
                    text: "Included Mods:";
                    font-weight: 700;
                }

                ScrollView {

                    VerticalLayout {
                        spacing: 0px;

                        for entry in root.games[root.selected-index].modlist: HorizontalBox {
                            alignment: start;
                            spacing: 0px;

                            Rectangle {
                                width: entry.depth * 16px;
                            }

                            Text {
                                text: "• " + entry.name;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                HorizontalBox {
                    alignment: start;

                    Button {
                        text: "Patch!";
                        clicked => {
                            root.patch-clicked(root.selected-index);
                     }
                }
            }
        }
    }
}
